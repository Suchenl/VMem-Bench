  "entities": {
    "E1": {
      "name": "沈砚",
      "kind": "character",
      "states": {
        "壮年领队": "三十多岁的驼队掌柜，络腮短须，裹姜黄头巾，穿深褐皮袄，腰挂铜秤砣，目光锐利。",
        "沙伤跛行": "同一位沈砚：头巾被沙砾刮破、左腿缠着麻布、拄着断矛柄跛行，皮袄沾满血痂与沙土。",
        "客死关城": "沈砚阖眼长逝，静静躺在关城土炕上，皮袄盖住胸口，气息全无。"
      }
    },
    "E2": {
      "name": "小禾",
      "kind": "character",
      "states": {
        "少年驼工": "十四五岁的驼工少女，身形清瘦，系靛蓝腰带，左耳戴一枚小铜铃，眉眼清亮倔强。",
        "成年掌柜": "二十余岁的女掌柜，仍系靛蓝腰带、左耳铜铃，身形挺拔，眉眼沉稳。"
      }
    },
    "E3": {
      "name": "铜狮火漆印",
      "kind": "prop",
      "states": {
        "完好": "一枚掌心大的铜狮钮火漆印，鬃纹清晰，印面刻着『沈记』二字，火漆鲜红未裂。",
        "沙裂": "同一枚铜狮火漆印，鬃纹被沙尘磨秃，印面出现一道裂纹，火漆斑驳脱落。",
        "补铸": "铜狮火漆印裂纹处补铸了新铜，鬃纹略浅，『沈记』二字仍可辨，火漆重新烫红。"
      }
    },
    "E4": {
      "name": "驼铃账册",
      "kind": "prop",
      "states": {
        "完好": "一本羊皮封面的驼铃账册，用驼毛绳捆着，内页用朱墨记着草料与脚价。",
        "沙渍糊字": "同一本驼铃账册被黄沙灌满书脊，封面起皱、朱墨晕成褐斑。"
      }
    },
