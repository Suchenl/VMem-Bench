{
  "story_id": "0019_lantern_festival_maker",
  "title": "金鲤灯夜",
  "premise": "跨越数十年的元宵扎灯传承。团团与圆圆外形极易错认；金鲤花灯完好→燎穿→重裱；灯笼板车烧毁后须规避；数量记忆与假朋友、时序闪回贯穿。仅作人读上下文，不喂给 SUT。",
  "_comment": "作者层：人只写 entities + 状态机 + 分场时间线（present + 手写 action + 语义事件）。present 项可为对象以附带 confusable_with/count/anchor 元数据。op/gap/probe/forbidden 由 complete_gt.py 派生。",
  "segment_sec": 5.0,
  "gap_long_threshold": 30,
  "avoidance_probe_window": 4,
  "probe_target_default": 5,
  "entities": {
    "E1": {
      "name": "沈灯",
      "kind": "character",
      "states": {
        "壮年灯匠": "五十上下的花灯匠沈灯，短须染霜，穿朱红短褂沾着颜料，手指骨节粗大，眼神专注。",
        "眼伤扶杖": "同一位灯匠的伤后之貌：右眼蒙纱布、扶竹杖缓行，短褂袖口被烛火燎焦。",
        "离世": "沈灯阖眼长逝，静静躺在灯棚草席上，面容安详、气息全无。"
      }
    },
    "E2": {
      "name": "团团",
      "kind": "character",
      "states": {
        "少年学徒": "少年团团：十四五岁、清瘦的扎灯学徒，系赭红围巾，穿补丁蓝布衫，眉眼清亮倔强。",
        "成年接班": "成年团团：二十余岁、手稳肩宽的年轻灯匠，仍系赭红围巾，蓝布衫换成朱红短褂。"
      }
    },
    "E3": {
      "name": "金鲤花灯",
