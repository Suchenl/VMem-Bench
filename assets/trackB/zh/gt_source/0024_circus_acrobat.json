    "E1": {
      "name": "裴烈",
      "kind": "character",
      "states": {
        "壮年领衔": "五十余岁的团长裴烈，花白寸头，穿深红燕尾服与黑马甲，胸口别着镀金哨子，双手布满茧与旧伤疤。",
        "摔伤拄杖": "同一位裴烈的摔伤之貌：右腿夹板、拄着黑漆手杖缓行，仍穿那件褪色深红燕尾服。",
        "离世": "裴烈阖眼长逝，静静躺在篷后化妆间的窄榻上，面容安详、气息全无。"
      }
    },
    "E2": {
