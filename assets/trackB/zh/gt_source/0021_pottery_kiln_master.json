      "states": {
        "壮年守火": "五十余岁的柴窑伯，花白短辫，穿土红粗布褂与黑围裙，袖口沾满瓷土，双手布满烫疤，眼神沉稳如火。",
        "烫伤拄杖": "同一位柴窑伯的烫伤后之貌：右臂绷带、跛脚拄着竹拐，仍穿那件烟灰土红粗布褂。",
        "离世": "柴窑伯阖眼长逝，静静躺在窑棚窄榻上，面容安详、气息全无。"
      }
    },
