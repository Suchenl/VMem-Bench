{
  "story_id": "0014_forge_swordsmith",
  "title": "霜纹砧上",
  "premise": "跨越数十年的山间锻刀传承。小葵与阿禾外形极易错认；霜纹剑坯完好→开裂→重锻；运炭驴车报废后须规避；数量记忆与假朋友、时序闪回贯穿。仅作人读上下文，不喂给 SUT。",
  "_comment": "作者层：人只写 entities + 状态机 + 分场时间线（present + 手写 action + 语义事件）。present 项可为对象以附带 confusable_with/count/anchor 元数据。op/gap/probe/forbidden 由 complete_gt.py 派生。",
  "segment_sec": 5.0,
  "gap_long_threshold": 30,
  "avoidance_probe_window": 4,
  "probe_target_default": 5,
  "entities": {
    "E1": {
      "name": "沈铁生",
      "kind": "character",
      "states": {
        "壮年铁匠": "五十上下的锻刀匠沈铁生，络腮短须，穿沾满氧化皮的深灰短褂，臂膀布满烫伤疤，眼神刚硬。",
        "烫伤跛行": "同一位铁匠的伤后之貌：右臂绷带渗黄、跛着左腿拄铁杖，短褂烧出几个洞。",
        "离世": "沈铁生阖眼长逝，静静躺在砧旁草席上，面容安详、气息全无。"
      }
    },
    "E2": {
      "name": "小葵",
      "kind": "character",
      "states": {
        "少年学徒": "少年小葵：十四五岁、瘦削的锻刀学徒，系朱红头巾，穿粗麻围裙，眉眼清亮倔强。",
        "成年接班": "成年小葵：二十余岁、臂膀结实的年轻铁匠，仍系朱红头巾，围裙换成厚牛皮。"
      }
    },
    "E3": {
      "name": "霜纹剑坯",
      "kind": "prop",
      "states": {
        "完好": "一柄尚未开刃的霜纹剑坯，钢脊泛着冷白折花，护手是素铜圆环，尚未装柄。",
        "淬火开裂": "同一柄剑坯在淬火中崩出纵向裂纹，折花断裂，铜环护手歪斜。",
        "重锻修复": "剑坯裂纹被回炉重锻弥合，折花重新显现，铜环护手复位，可继续开刃。"
      }
    },
    "E4": {
      "name": "炉火配方册",
      "kind": "prop",
      "states": {
        "完好": "一本油布封面的炉火配方册，夹着炭比纸条，页边被火星烫出小孔。",
        "油烟污损": "同一本配方册被油烟熏黑，封面发黏、字迹糊成墨团。"
      }
    },
    "E5": {
      "name": "运炭驴车",
      "kind": "prop",
      "states": {
        "完好": "一辆木制双轮驴车，车厢装满焦炭袋，车辕漆着『沈』字，轮毂包铁。",
        "轴折报废": "驴车车轴折断翻倒，焦炭散落，车辕断裂，成为无法再拉的残骸。"
      }
    },
    "E6": {
