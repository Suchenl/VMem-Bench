  "gap_long_threshold": 30,
  "avoidance_probe_window": 4,
  "probe_target_default": 5,
  "_state_note": "有状态机的实体用 states；无状态的实体用 appearance。闪回可在 present 项写 state。",
  "entities": {
    "E1": {
      "name": "田埂伯",
      "kind": "character",
      "states": {
        "壮年看水": "五十余岁的田埂伯，花白短发，穿墨绿蓑衣与粗布裤，腰间挂着竹制水位尺，小腿沾满泥浆，眼神沉稳。",
        "腰伤拄杖": "同一位田埂伯的腰伤之貌：弯腰困难、拄着黄藤拐杖缓行，仍穿那件褪色墨绿蓑衣。",
        "离世": "田埂伯阖眼长逝，静静躺在田寮窄榻上，面容安详、气息全无。"
      }
    },
    "E2": {
      "name": "小舟",
      "kind": "character",
      "states": {
        "少年学耕": "少年时的小舟：十四五岁、清瘦的插秧学徒，系青绿头巾，穿灰褐短褂，左腕系稻草编织手绳，眉眼清亮倔强。",
        "成年接班": "成年后的小舟：二十余岁、肩宽的看水人，仍系青绿头巾、左腕稻草手绳，神情沉稳。"
      }
    },
    "E3": {
      "name": "水车龙骨",
      "kind": "prop",
      "states": {
        "完好转水": "一架立在田埂边的木制水车龙骨，车叶完好，龙骨槽淌着清亮水线，吱呀转动。",
        "折齿卡死": "同一架水车龙骨车叶折齿卡死，龙骨槽干涸，轮轴歪斜。",
        "换齿修复": "水车龙骨更换新车叶后恢复转动，龙骨留有新木补丁，区别于最初完好态。"
      }
    },
    "E4": {
      "name": "水情册",
      "kind": "prop",
      "states": {
        "完好": "一本油纸封面的水情册，封皮写着『南坡九丘』，内页用毛笔记满开闸时刻与水位。",
        "泥水污损": "同一本水情册被田泥水浸透，封面鼓皱，字迹糊成泥斑。"
      }
    },
    "E5": {
      "name": "青秧号",
      "kind": "prop",
      "states": {
        "完好": "一辆髹青漆的双轮牛车，车帮漆着白字『青秧号』，车斗铺着稻草用于运秧。",
        "田埂倾覆": "青漆牛车在田埂倾覆，车帮崩裂、稻草散落，成为无法再运秧的残骸。"
      }
    },
    "E6": {
      "name": "阿香",
      "kind": "character",
      "states": {
        "少年串门": "少年时的阿香：与小舟面容极相似，却系姜黄头巾、右腕佩一枚竹节手镯，神情更俏皮。",
        "成年织席": "成年后的阿香：与成年小舟面容极相似，仍系姜黄头巾、佩竹节手镯，肩挎苇席卷。"
