{
  "story_id": "0006_harbor_ice_cutter",
  "title": "碎冰港湾",
  "premise": "北方碎冰港湾的师徒接力。船长江澄与水手青芽守护双齿破冰钩；青芽与阿霜面容极似却耳罩不同；海豹号冰切艇撞毁后须规避；港湾冰情簿、数量记忆与时序闪回贯穿。仅作人读上下文，不喂给 SUT。",
  "_comment": "作者层：人只写 entities + 状态机 + 分场时间线（present + 手写 action + 语义事件）。op/gap/probe/forbidden 由 complete_gt.py 派生。",
  "segment_sec": 5.0,
  "gap_long_threshold": 30,
  "avoidance_probe_window": 4,
  "probe_target_default": 5,
  "entities": {
    "E1": {
      "name": "江澄",
      "kind": "character",
      "states": {
        "壮年破冰": "四十岁的港湾破冰船长，络腮胡结着冰霜，穿深蓝油布大衣和钉底胶靴，肩上常扛缠麻绳的冰钩，目光坚硬沉稳。",
        "冻伤扶杖": "同一位江澄多年后的模样：右手冻伤缠厚毡，拄一根旧桨改成的木杖，深蓝油布大衣肩口磨白。",
        "海葬离世": "江澄阖眼长逝，静静躺在船屋木床上，胸前盖着那件旧油布大衣。"
      }
    },
    "E2": {
      "name": "青芽",
      "kind": "character",
      "states": {
        "少年水手": "十六岁的水手少女，辫梢缠蓝绳，穿短款油布背心，脸颊被海风刮得通红，动作利落。",
        "成年船长": "二十出头的女船长，仍辫梢缠蓝绳，油布背心换成宽肩款，眼神沉稳，腰间挂小冰锥。"
      }
    },
    "E3": {
      "name": "双齿破冰钩",
      "kind": "prop",
      "states": {
        "完好": "一根一人高的双齿破冰钩，钩齿泛着冷亮钢光，长柄缠着防滑麻绳，柄尾刻有港湾编号。",
        "钩齿裂开": "同一根双齿破冰钩的外侧钩齿被硬冰崩裂，麻绳散开，钢身留下白色折痕。",
        "换齿修复": "双齿破冰钩换上新钩齿并重新缠紧麻绳，新齿颜色略亮，柄尾港湾编号仍清晰。"
      }
    },
    "E4": {
      "name": "港湾冰情簿",
      "kind": "prop",
      "states": {
        "完好": "一本油布封面的港湾冰情簿，用蜡线订着，内页画着潮线、冰厚和泊位编号。",
        "海水洇透": "同一本港湾冰情簿被海水洇透，油布封面发白起皱，潮线和冰厚数字晕成淡蓝斑。"
      }
    },
    "E5": {
      "name": "海豹号冰切艇",
      "kind": "prop",
      "states": {
        "完好": "一艘窄身冰切艇，船头画白色海豹，船舷挂两排冰刀护木，艉部盘着粗麻泊缆。",
        "撞毁": "海豹号冰切艇被流冰挤碎，船头海豹图案裂成两半，冰刀护木脱落，只剩残舷浮在碎冰间。"
      }
    },
    "E6": {
