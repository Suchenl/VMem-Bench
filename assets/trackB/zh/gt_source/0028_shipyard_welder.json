  "entities": {
    "E1": {
      "name": "周临",
      "kind": "character",
      "states": {
        "壮年在岗": "三十多岁的船坞焊工周临，短寸头、颧骨有焊疤，穿焦褐防火服与钢头靴，肩挎墨绿色氩弧焊面罩，双手粗糙沾着铁屑。",
        "疲惫负伤": "同一位周临：防火服袖口烧穿、左眉绷着纱布，拄着焊枪箱缓行，眼神发沉却仍盯着焊缝。",
        "离世": "周临阖眼长逝，静静躺在船坞医务室的铁床上，面容安详、气息全无。"
      }
    },
    "E2": {
      "name": "星子",
      "kind": "character",
      "states": {
