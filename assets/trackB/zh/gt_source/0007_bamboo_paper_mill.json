  "gap_long_threshold": 30,
  "avoidance_probe_window": 4,
  "probe_target_default": 5,
  "entities": {
    "E1": {
      "name": "白鹭",
      "kind": "character",
      "states": {
        "壮年抄纸": "四十岁的抄纸师傅，青布包头，麻布围裙沾满纸浆，双手泡得发白，手腕动作稳准。",
        "烫伤扶杖": "同一位白鹭：小臂被沸浆烫伤缠着草药布，拄断竹杖，麻布围裙焦了一角。",
        "病逝碓房": "白鹭阖眼长逝，静静躺在水碓房木榻上，麻布围裙盖住胸口。"
      }
    },
    "E2": {
      "name": "米粒",
      "kind": "character",
      "states": {
        "少年学徒": "十五岁的学徒女孩，围草木染围腰，腕上戴竹篾环，指尖常留纸浆白痕。",
        "成年师傅": "二十出头的女师傅，仍围草木染围腰、戴竹篾环，身形挺拔，能一把抄起整张湿纸。"
      }
    },
    "E3": {
      "name": "竹帘抄纸帘",
      "kind": "prop",
      "states": {
        "完好": "一床细密的竹帘抄纸帘，帘丝匀直，老竹边框磨得发亮，表面沾着均匀白浆。",
        "帘丝撕裂": "同一床竹帘抄纸帘崩断数根帘丝，边框被水流撞裂，干结浆斑卡在缝里。",
        "重绷修复": "竹帘抄纸帘被重新绷紧，缺失帘丝补齐，老竹边框箍上新竹钉，浆面恢复平整。"
      }
    },
    "E4": {
      "name": "纸浆配方册",
      "kind": "prop",
