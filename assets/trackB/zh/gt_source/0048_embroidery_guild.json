      "kind": "character",
      "states": {
        "壮年在岗": "四十余岁的绣坊坊主沈织，挽髻插银簪，穿月白对襟褂，指尖常沾丝线绒，目光细而稳。",
        "疲惫负伤": "同一位沈织的疲惫负伤之貌：对襟褂袖口烧焦、食指缠纱布，仍插着银簪，步履发沉。",
        "离岗谢幕": "沈织已离岗谢幕，绣楼只留她的月白旧褂与坊主牌，人影不再出现。"
      }
    },
