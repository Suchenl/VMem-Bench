  "entities": {
    "E1": {
      "name": "静空",
      "kind": "character",
      "states": {
        "壮年在岗": "五十余岁的撞钟僧静空，剃度青灰，穿土黄僧袍，腕缠粗麻护腕，掌心老茧深厚，神情沉静。",
        "疲惫负伤": "同一位静空的疲惫负伤之貌：僧袍撕破一角、右腕缠白布，仍缠着粗麻护腕，步履发沉。",
        "离岗谢幕": "静空已离岗谢幕，钟楼只留他的土黄旧僧袍与功课牌，人影不再出现。"
      }
    },
    "E2": {
