      "kind": "character",
      "states": {
        "少年学徒": "少年时的阿澄：十五岁左右、清瘦的沙弥学徒，脚踝系姜黄僧袜带，眉眼清亮倔强。",
        "成年接班": "成年后的阿澄：二十余岁、肩背结实的接班撞钟人，仍系姜黄僧袜带，眉眼沉稳。"
      }
    },
