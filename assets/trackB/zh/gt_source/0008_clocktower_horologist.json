  "entities": {
    "E1": {
      "name": "韩霜",
      "kind": "character",
      "states": {
        "壮年修表": "四十岁的钟楼技师，戴灰呢报童帽，穿灰呢工装，胸前挂放大镜，手指修长而沾着机油。",
        "扭伤拄杖": "同一位韩霜：右踝旧伤，拄一根断尺改成的手杖，灰呢工装膝部磨破，放大镜仍挂胸前。",
        "静默离世": "韩霜阖眼长逝，静静躺在钟楼机房折叠床上，灰呢工装盖住胸口。"
      }
    },
    "E2": {
      "name": "豆豆",
      "kind": "character",
      "states": {
        "少年学徒": "十五岁的学徒女孩，穿深蓝背带裤，腰间挂小怀表链，眼神机敏。",
        "成年技师": "二十出头的女技师，仍挂怀表链、穿深蓝背带裤，身形挺拔，能独自校准整套钟机。"
      }
    },
